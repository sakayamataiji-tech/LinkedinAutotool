# PostgreSQL connection strings used by Prisma.
# DATABASE_URL: pooled connection (Neon pooler / PgBouncer) — used at runtime.
# DIRECT_URL:   direct (non-pooled) connection — used by prisma migrate.
# Locally, set both to the same value.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/linkedinautotool?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/linkedinautotool?schema=public"

# --- Scheduler ---
# Shared secret for the cron endpoint (/api/cron/run). When set, requests must
# present it via `Authorization: Bearer <secret>` or `?secret=<secret>`.
CRON_SECRET=""
# Run the scheduler inside the Next.js server process (good for `next start`).
ENABLE_INPROCESS_SCHEDULER="false"
# In-process scheduler interval in milliseconds (default 60000).
SCHEDULER_INTERVAL_MS="60000"

# --- LinkedIn provider ---
# "mock" (default, no account needed) or "playwright" (real automation).
LINKEDIN_PROVIDER="mock"
# Your own LinkedIn session cookie (li_at). REQUIRED for the playwright provider.
# ⚠️ Automating LinkedIn violates its User Agreement and risks account ban.
LINKEDIN_LI_AT=""
# Path to a Chromium executable for playwright-core (else uses the default).
PLAYWRIGHT_CHROMIUM_PATH=""
# Set "true" to launch a visible browser (debugging). Default headless.
LINKEDIN_HEADFUL="false"
# Set "true" to navigate/read but skip mutating clicks (safe rehearsal).
LINKEDIN_DRY_RUN="false"
