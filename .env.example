# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/linkedinautotool?schema=public"

# --- Scheduler ---
# Shared secret for the cron endpoint (/api/cron/run). When set, requests must
# present it via `Authorization: Bearer <secret>` or `?secret=<secret>`.
CRON_SECRET=""
# Run the scheduler inside the Next.js server process (good for `next start`).
ENABLE_INPROCESS_SCHEDULER="false"
# In-process scheduler interval in milliseconds (default 60000).
SCHEDULER_INTERVAL_MS="60000"
